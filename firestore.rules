rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /survey_submissions/{document} {
      allow read, write: if true;
    }
    match /announcements/{document} {
      allow read, write: if true;
    }
    match /classes/{document} {
      allow read, write: if true;
    }
  }
}
